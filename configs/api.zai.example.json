{
  "agent": {
    "api": "chat_completions",
    "base_url": "https://api.z.ai/api/paas/v4",
    "model": "glm-5.3",
    "api_key_env": "SWE_PERSONA_AGENT_API_KEY",
    "strict_json_schema": false,
    "timeout_sec": 300,
    "request_options": {
      "reasoning_effort": "max",
      "temperature": 1,
      "extra_body": {
        "thinking": {
          "type": "enabled",
          "clear_thinking": false
        }
      }
    },
    "structured_output_mode": "prompt",
    "max_tokens_field": "max_tokens"
  },
  "user_simulator": {
    "api": "chat_completions",
    "base_url": "https://api.z.ai/api/paas/v4",
    "model": "glm-5.3",
    "api_key_env": "SWE_PERSONA_SIMULATOR_API_KEY",
    "strict_json_schema": false,
    "timeout_sec": 300,
    "request_options": {
      "reasoning_effort": "high",
      "temperature": 1,
      "extra_body": {
        "thinking": {
          "type": "enabled",
          "clear_thinking": false
        }
      },
      "max_tokens": 32768
    },
    "structured_output_mode": "prompt",
    "max_tokens_field": "max_tokens"
  }
}
