{
  "agent": {
    "api": "chat_completions",
    "base_url": "https://your-agent-service.example/v1",
    "model": "YOUR_CODING_MODEL",
    "api_key_env": "SWE_PERSONA_AGENT_API_KEY",
    "strict_json_schema": true,
    "timeout_sec": 120,
    "structured_output_mode": "json_schema",
    "structured_output_fallback": true,
    "max_tokens_field": "max_completion_tokens"
  },
  "user_simulator": {
    "api": "responses",
    "base_url": "https://matraix.services.ai.azure.com/openai/v1",
    "model": "gpt-6-luna",
    "api_key_env": "SWE_PERSONA_SIMULATOR_API_KEY",
    "strict_json_schema": true,
    "structured_output_mode": "json_schema",
    "structured_output_fallback": true,
    "timeout_sec": 300,
    "request_options": {
      "reasoning_effort": "medium",
      "max_output_tokens": 32768
    }
  }
}
